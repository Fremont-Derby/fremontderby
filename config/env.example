# Copy values into the appropriate local/Cloudflare environment.
# Public/static values belong in wrangler.jsonc. Secret values belong in
# Cloudflare secrets (or .dev.vars/.env locally) and must never be committed.
ENVIRONMENT=local
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=server-only-replace-me
EXPECTED_SUPABASE_PROJECT_REF=example-project-ref

# Isolated beta lanes only (never gamma/staging/production)
# BETA_AUTH_BYPASS=1
# BETA_ACTOR_USER_ID=
# BETA_ACTOR_EMAIL=beta-actor@localhost
