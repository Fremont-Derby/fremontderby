{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "fremontderby",
  "main": "src/routerEntry.js",
  "compatibility_date": "2026-08-09",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://cpiucsxlkicmlbvdvhww.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_7WQihuB4HVf-xFKMBeYIng_bUP--oUz"
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "SUPABASE_URL": "https://oqkkvqkerusepyokzbmt.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_pxpey3nrNt1nWQ2CBXJhQg_btWE10eB"
      }
    },
    "beta": {
      "name": "fremontderby-beta",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "beta",
        "BETA_AUTH_BYPASS": "1",
        "SUPABASE_URL": "https://REPLACE_BETA_PROJECT.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "REPLACE_BETA_PUBLISHABLE_KEY",
        "BETA_ACTOR_USER_ID": "REPLACE_BETA_ACTOR_USER_UUID",
        "BETA_ACTOR_EMAIL": "beta-actor@localhost",
        "BETA_EXPECTED_SUPABASE_PROJECT_REF": "REPLACE_BETA_PROJECT_REF"
      }
    }
  }
}
